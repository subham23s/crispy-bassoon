# CyberSecRA-X local configuration
APP_NAME=CyberSecRA-X
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=sqlite:///data/cybersecra.db
# Optional alternate corpus/artifact directory; acquisition and processing honor it.
# DATA_DIR=/absolute/path/to/data
# Docker infra profile targets (e.g. DATABASE_URL=postgresql+psycopg://cybersecra:change-me-local-only@postgres:5432/cybersecra):
POSTGRES_DB=cybersecra
POSTGRES_USER=cybersecra
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Bounded optional-service probes and SQLAlchemy pool sizing.
SERVICE_CONNECT_TIMEOUT=0.5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional approved OpenAI-compatible provider. Leave LLM_PROVIDER=none for deterministic local mode.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=tfidf-lite
RERANKER_PROVIDER=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Binary checkpoints must declare which output is relevance (e.g. LABEL_1 for a reviewed legacy checkpoint).
RERANKER_RELEVANT_LABEL=RELEVANT
INTENT_PROVIDER=auto
OOD_PROVIDER=auto
INTENT_MODEL=data/ml/intent/transformer_model
OOD_MODEL=data/ml/ood/transformer_model
NLI_PROVIDER=auto
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_DEVICE=-1
NVD_API_KEY=
NVD_RESULTS_PER_PAGE=2000
NVD_MAX_PAGES=5
NVD_REQUEST_DELAY_SECONDS=
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
MAX_UPLOAD_BYTES=26214400
BACKGROUND_UPLOAD_BYTES=2097152
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
CERS_ABSTENTION_THRESHOLD=0.42
CERS_CALIBRATION_STATUS=pending-human-calibration
CERS_WEIGHTS=
